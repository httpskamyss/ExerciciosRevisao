            // Inverte o status de conclusão da tarefa selecionada
            tarefas[index].concluida = !tarefas[index].concluida;
            atualizarTela();
        }

        function excluirTarefa(index) {
            // Remove a tarefa do array pelo índice
            tarefas.splice(index, 1);
            atualizarTela();
        }

