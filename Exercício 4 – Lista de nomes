<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Lista de Nomes</title>
    <style>
        body {
            font-family: Arial, sans-serif;
            background-color: #f4f4f9;
            display: flex;
            justify-content: center;
            align-items: center;
            height: 100vh;
            margin: 0;
        }
        .container {
            background: white;
            padding: 30px;
            border-radius: 10px;
            box-shadow: 0 4px 10px rgba(0, 0, 0, 0.1);
            width: 100%;
            max-width: 400px;
        }
        h2 {
            color: #333;
            text-align: center;
            margin-bottom: 20px;
        }
        .input-group {
            display: flex;
            gap: 10px;
            margin-bottom: 15px;
        }
        input[type="text"] {
            flex: 1;
            padding: 10px;
            border: 1px solid #ccc;
            border-radius: 5px;
            font-size: 1rem;
        }
        button {
            padding: 10px 20px;
            font-size: 1rem;
            font-weight: bold;
            border: none;
            border-radius: 5px;
            cursor: pointer;
            background-color: #007bff;
            color: white;
            transition: background 0.2s;
        }
        button:hover {
            background-color: #0056b3;
        }
        #mensagem-erro {
            color: #dc3545;
            font-size: 0.9rem;
            margin-bottom: 10px;
            text-align: center;
            height: 15px; /* Mantém o espaço reservado para evitar pulos na tela */
        }
        ul {
            list-style-type: disc;
            padding-left: 20px;
            margin: 0;
            max-height: 200px;
            overflow-y: auto;
        }
        li {
            padding: 5px 0;
            color: #444;
            border-bottom: 1px solid #eee;
        }
    </style>
</head>
<body>

    <div class="container">
        <h2>Lista de Nomes</h2>
        
        <div class="input-group">
            <input type="text" id="nomeInput" placeholder="Digite um nome...">
            <button onclick="adicionarNome()">Adicionar</button>
        </div>

        <div id="mensagem-erro"></div>

        <!-- Lista vazia onde os nomes serão inseridos -->
        <ul id="listaNomes"></ul>
    </div>

    <script>
        function adicionarNome() {
            const inputNome = document.getElementById('nomeInput');
            const listaNomes = document.getElementById('listaNomes');
            const divErro = document.getElementById('mensagem-erro');

            // Remove espaços em branco extras do texto digitado
            const nomeDigitado = inputNome.value.trim();

            // Limpa mensagens de erro anteriores
            divErro.textContent = "";

            // Validação: não permitir adicionar nomes vazios
            if (nomeDigitado === "") {
                divErro.textContent = "Por favor, digite um nome válido.";
                inputNome.focus();
                return;
            }

            // Cria um novo elemento de lista (li)
            const novoItem = document.createElement('li');
            novoItem.textContent = nomeDigitado;

            // Adiciona o novo item dentro da lista (ul)
            listaNomes.appendChild(novoItem);

            // Limpa o campo de texto após a inclusão
            inputNome.value = "";

            // Retorna o foco para o input para facilitar novas digitações
            inputNome.focus();
        }

        // Opcional: Permite adicionar o nome pressionando a tecla "Enter" no teclado
        document.getElementById('nomeInput').addEventListener('keypress', function(event) {
            if (event.key === 'Enter') {
                adicionarNome();
            }
        });
    </script>

</body>
</html>
