<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Controle de Estoque</title>
    <style>
        body {
            font-family: Arial, sans-serif;
            background-color: #f4f4f9;
            display: flex;
            justify-content: center;
            align-items: center;
            min-height: 100vh;
            margin: 0;
        }
        .container {
            background: white;
            padding: 30px;
            border-radius: 10px;
            box-shadow: 0 4px 10px rgba(0, 0, 0, 0.1);
            width: 100%;
            max-width: 500px;
        }
        h2 {
            color: #333;
            text-align: center;
            margin-bottom: 20px;
        }
        .input-group {
            margin-bottom: 12px;
            text-align: left;
        }
        label {
            display: block;
            margin-bottom: 4px;
            color: #555;
            font-weight: bold;
            font-size: 0.9rem;
        }
        input[type="text"], 
        input[type="number"] {
            width: 100%;
            padding: 10px;
            box-sizing: border-box;
            border: 1px solid #ccc;
            border-radius: 5px;
            font-size: 1rem;
        }
        button {
            width: 100%;
            padding: 10px;
            font-size: 1rem;
            font-weight: bold;
            border: none;
            border-radius: 5px;
            cursor: pointer;
            transition: background 0.2s;
        }
        .btn-cadastrar {
            background-color: #007bff;
            color: white;
            margin-top: 5px;
        }
        .btn-cadastrar:hover {
            background-color: #0056b3;
        }
        #mensagem-erro {
            color: #dc3545;
            font-size: 0.9rem;
            margin: 10px 0;
            text-align: center;
            height: 15px;
        }
        .painel-total {
            background-color: #e9ecef;
            padding: 12px;
            border-radius: 5px;
            text-align: center;
            font-weight: bold;
            color: #333;
            margin-bottom: 15px;
            font-size: 1.1rem;
        }
        ul {
            list-style-type: none;
            padding: 0;
            margin: 0;
            max-height: 220px;
            overflow-y: auto;
        }
        li {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 10px;
            margin-bottom: 8px;
            background-color: #f9f9f9;
            border: 1px solid #eee;
            border-radius: 5px;
        }
        .produto-info {
            flex: 1;
            font-size: 0.9rem;
            color: #333;
            word-break: break-word;
            margin-right: 10px;
            line-height: 1.4;
        }
        .btn-excluir {
            background-color: #dc3545;
            color: white;
            font-size: 0.85rem;
            padding: 6px 10px;
            width: auto;
            height: fit-content;
        }
        .btn-excluir:hover {
            background-color: #c82333;
        }
    </style>
</head>
<body>

    <div class="container">
        <h2>Controle de Estoque</h2>
        
        <div class="input-group">
            <label for="nomeInput">Nome do Produto:</label>
            <input type="text" id="nomeInput" placeholder="Ex: Caderno">
        </div>

        <div class="input-group">
            <label for="quantidadeInput">Quantidade:</label>
            <input type="number" id="quantidadeInput" placeholder="Ex: 15" min="0">
        </div>

        <div class="input-group">
            <label for="precoInput">Preço Unitário (R$):</label>
            <input type="number" id="precoInput" placeholder="Ex: 10.50" step="0.01" min="0">
        </div>

        <button class="btn-cadastrar" onclick="cadastrarProduto()">Cadastrar Produto</button>

        <div id="mensagem-erro"></div>

        <!-- Painel para exibir o valor total do estoque -->
        <div class="painel-total" id="painelTotal">Valor Total do Estoque: R$ 0,00</div>

        <!-- Lista de produtos cadastrados -->
        <ul id="listaEstoque"></ul>
    </div>

    <script>
        // Array para armazenar os produtos do estoque
        let estoque = [];

        function cadastrarProduto() {
            const inputNome = document.getElementById('nomeInput');
            const inputQuantidade = document.getElementById('quantidadeInput');
            const inputPreco = document.getElementById('precoInput');
            const divErro = document.getElementById('mensagem-erro');

            const nome = inputNome.value.trim();
            const qtdStr = inputQuantidade.value.trim();
            const precoStr = inputPreco.value.trim();

            divErro.textContent = "";

            // Validação de campos vazios
            if (nome === "" || qtdStr === "" || precoStr === "") {
                divErro.textContent = "Por favor, preencha todos os campos.";
                return;
            }

            const quantidade = parseInt(qtdStr);
            const preco = parseFloat(precoStr);

            // Validação de valores numéricos válidos
            if (quantidade < 0 || preco < 0) {
                divErro.textContent = "Quantidade e preço não podem ser negativos.";
                return;
            }

            // Adiciona o novo produto ao array de estoque
            estoque.push({ nome: nome, quantidade: quantidade, preco: preco });

            // Limpa os campos e retorna o foco para o primeiro input
            inputNome.value = "";
            inputQuantidade.value = "";
            inputPreco.value = "";
            inputNome.focus();

            atualizarTela();
        }

        function excluirProduto(index) {
            // Remove o produto do array pelo seu índice
            estoque.splice(index, 1);
            atualizarTela();
        }

        function atualizarTela() {
            const listaEstoque = document.getElementById('listaEstoque');
            const painelTotal = document.getElementById('painelTotal');

            listaEstoque.innerHTML = "";

            if (estoque.length === 0) {
                painelTotal.textContent = "Valor Total do Estoque: R$ 0,00";
                return;
            }

            let valorTotalGeral = 0;

            // Percorre o array para renderizar cada item e calcular o montante total
            estoque.forEach((produto, index) => {
                let subtotal = produto.quantidade * produto.preco;
                valorTotalGeral += subtotal;

                const novoLi = document.createElement('li');

                const divInfo = document.createElement('div');
                divInfo.className = 'produto-info';
                divInfo.innerHTML = `<strong>${produto.nome}</strong><br>
                                     Qtd: ${produto.quantidade} | Preço: R$ ${produto.preco.toFixed(2)}<br>
                                     Subtotal: R$ ${subtotal.toFixed(2)}`;

                const btnExcluir = document.createElement('button');
                btnExcluir.textContent = "Excluir";
                btnExcluir.className = 'btn-excluir';
                btnExcluir.onclick = function() {
                    excluirProduto(index);
                };

                novoLi.appendChild(divInfo);
                novoLi.appendChild(btnExcluir);
                listaEstoque.appendChild(novoLi);
            });

            // Exibe o valor total geral formatado em Reais (R$)
            painelTotal.textContent = `Valor Total do Estoque: R$ ${valorTotalGeral.toFixed(2)}`;
        }
    </script>

</body>
</html>
